# Research Report 后端配置示例
# 用法：复制为 .env 后按需修改（cp .env.example .env）。.env 为本地配置，请勿提交到仓库。
#
# 优先级（从高到低）：命令行参数 / 真实环境变量 > .env > 代码内默认值

# hermes 可执行文件路径（默认 ~/.hermes/hermes-agent/venv/bin/hermes；~ 会自动展开）
HERMES_BIN=~/.hermes/hermes-agent/venv/bin/hermes

# 默认 Agent profile
DEFAULT_PROFILE=hermes-research-report-agent

# 服务监听端口（默认 8649；命令行参数优先，如 python server.py 8650）
PORT=8649
